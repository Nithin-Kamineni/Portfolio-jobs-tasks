{
  "name": "owner-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal website: a public portfolio plus private task manager and job tracker (Astro + React on Cloudflare Workers, D1).",
  "scripts": {
    "dev": "wrangler types && astro dev",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && wrangler types && astro check && astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:backup": "node scripts/backup-d1.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@mui/x-data-grid": "^7.29.13",
    "@tanstack/react-query": "^5.104.2",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "astro": "^7.3.8",
    "dompurify": "^3.4.17",
    "jose": "^6.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.149.0"
  }
}
